# ── FH Technikum Wien "Lion" — Local LLM (default) ──────────────────────────
# Pilot service running Qwen3.6-35B-A3B on-premise (OpenAI-compatible endpoint).
# All lectures default to this model; students receive their key with the course.
# Keep OPENAI_API_KEY private — do not commit it to the repository.
USE_LOCAL_LLM=true
OPENAI_API_KEY=your_lion_api_key_here
OPENAI_BASE_URL=https://lion.aida.cs.technikum-wien.at/v1

# ── Google Gemini (optional alternative) ──────────────────────────────────────
# Set USE_LOCAL_LLM=false above to switch agents to Gemini.
# Get a free key at: https://aistudio.google.com/app/api-keys
GEMINI_API_KEY=your_gemini_api_key_here

# ── LangSmith tracing (optional, Lecture 7 LangChain example) ────────────────
# Get a key at: https://smith.langchain.com/settings → API Keys.
# When enabled, every LLM call and tool call is sent to smith.langchain.com
# as a trace — no code change needed, LangChain auto-instruments.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_PROJECT=fh-lecture7-langchain

# ── Persistence (Lecture 5, Section 2) ─────────────────────────────────────────
# Start the database:  docker compose up -d  (from lecture5/02_add_persistence/)
# Default matches the docker-compose.yml defaults — change only if you customise it.
DATABASE_URL=postgresql+asyncpg://adk_user:adk_password@localhost:5432/adk_sessions
